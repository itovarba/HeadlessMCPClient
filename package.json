{
  "name": "local-salesforce-mcp-proxy",
  "version": "1.0.0",
  "description": "Local Headless 360 MCP proxy for Salesforce Hosted MCP Server.",
  "type": "module",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:proxy": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "llm:start": "OLLAMA_MODELS=.ollama-models OLLAMA_NO_CLOUD=1 OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 ollama serve",
    "llm:pull": "node scripts/pull-model.mjs"
  },
  "keywords": [
    "mcp",
    "salesforce",
    "proxy",
    "gateway",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
